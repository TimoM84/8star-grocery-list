# Copy to .env (or enter these in Dockhand's environment editor).

# Interface the app listens on. Use the server's LAN or VPN address (e.g. 192.168.1.10 or a
# Tailscale/WireGuard 100.x / 10.x address). Never 0.0.0.0 on a host with a public interface.
BIND_ADDRESS=127.0.0.1

# Host port that maps to the container's port 3000.
HOST_PORT=3000

# Public URL the app is reached at (needed behind a reverse proxy with HTTPS), e.g.
# ORIGIN=https://boodschappen.home.arpa
ORIGIN=

# When a reverse proxy terminates TLS, let it tell the app the original protocol/host:
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host
PROTOCOL_HEADER=
HOST_HEADER=

# Accent color of the whole app (six-digit hex). Applied at runtime: change it and recreate the
# container, no rebuild needed. Invalid values fall back to the default green. Keep the quotes.
APP_PRIMARY_COLOR="#1D7F46"

# Time zone for logs and backup file names.
TZ=Europe/Amsterdam

# Automatic online backups inside the data volume (/data/backups). 0 disables them.
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14

# Docker volume holding grocery.db and backups.
DATA_VOLUME=8star-grocery-data

# Release to run, without the "v". Builds the Git tag v<APP_VERSION> and tags the image with it.
# Change it after publishing a release, then Pull & redeploy.
APP_VERSION=1.4.0
